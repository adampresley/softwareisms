<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="description" content="<%= description %>" />
    <meta
      name="htmx-config"
      content='{"historyRestoreAsHxRequest":false,"allowEval":false,"includeIndicatorStyles":false}'
    />
    <title><%= title %></title>

    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/assets/styles.css" />

    <script src="/assets/htmx.min.js" defer></script>
    <script src="/assets/app.js" defer></script>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <header class="site-header shell flex items-center justify-between">
      <a
        class="brand flex items-center gap-3"
        href="/"
        aria-label="Softwareisms home"
        ><span class="brand-mark" aria-hidden="true">s<span>*</span></span
        >Softwareisms<span class="brand-period">.</span></a
      >
      <span class="header-note">Wanna sound smart?</span>
    </header>
  </body>
</html>
