{
   "name": "softwareisms",
   "version": "1.0.0",
   "private": true,
   "description": "A small, curated field guide to software laws and principles.",
   "type": "module",
   "engines": {
      "node": ">=24"
   },
   "scripts": {
      "build": "node scripts/build.js",
      "start": "node src/server.js",
      "dev": "npm run build && node --watch src/server.js",
      "test": "node --test test/*.test.js",
      "test:e2e": "playwright test"
   },
   "dependencies": {
      "ejs": "^3.1.10",
      "express": "^5.1.0",
      "htmx.org": "^2.0.8"
   },
   "devDependencies": {
      "@playwright/test": "^1.55.0",
      "@tailwindcss/cli": "^4.1.0",
      "prettier": "^3.9.8",
      "prettier-plugin-ejs": "^1.0.3",
      "tailwindcss": "^4.1.0"
   }
}
